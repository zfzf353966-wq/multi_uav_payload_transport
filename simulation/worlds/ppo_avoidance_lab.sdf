<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="ppo_avoidance_lab">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure" />
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed" />
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <physics name="fast_urban_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic" />
    <scene>
      <grid>false</grid>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.64 0.78 0.92 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 100 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>0.9</intensity>
      <direction>-0.35 0.25 -0.9</direction>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>1</constant>
        <linear>0</linear>
        <quadratic>0</quadratic>
      </attenuation>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971</latitude_deg>
      <longitude_deg>8.546164</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 60</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="grass">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 60</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.18 0.34 0.16 1</ambient>
            <diffuse>0.24 0.46 0.21 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="roads">
      <static>true</static>
      <link name="link">
        <visual name="east_west_road">
          <pose>0 0 0.012 0 0 0</pose>
          <geometry>
            <box>
              <size>80 7 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.09 0.10 0.11 1</ambient>
            <diffuse>0.16 0.17 0.18 1</diffuse>
          </material>
        </visual>
        <visual name="north_south_road">
          <pose>10 0 0.014 0 0 0</pose>
          <geometry>
            <box>
              <size>7 60 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.09 0.10 0.11 1</ambient>
            <diffuse>0.16 0.17 0.18 1</diffuse>
          </material>
        </visual>
        <visual name="depot_access_road">
          <pose>-25 -22 0.016 0 0 0</pose>
          <geometry>
            <box>
              <size>30 6 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.09 0.10 0.11 1</ambient>
            <diffuse>0.16 0.17 0.18 1</diffuse>
          </material>
        </visual>
        <visual name="lane_line_x">
          <pose>0 0 0.03 0 0 0</pose>
          <geometry>
            <box>
              <size>80 0.12 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.8 0.15 1</ambient>
            <diffuse>0.95 0.85 0.2 1</diffuse>
          </material>
        </visual>
        <visual name="lane_line_y">
          <pose>10 0 0.032 0 0 0</pose>
          <geometry>
            <box>
              <size>0.12 60 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.8 0.15 1</ambient>
            <diffuse>0.95 0.85 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="uav_depot">
      <static>true</static>
      <pose>-30 -23 0.055 0 0 0</pose>
      <link name="link">
        <collision name="apron_collision">
          <geometry>
            <box>
              <size>10 6 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="apron_visual">
          <geometry>
            <box>
              <size>10 6 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.35 0.37 0.39 1</ambient>
            <diffuse>0.55 0.57 0.59 1</diffuse>
          </material>
        </visual>
        <visual name="pad_1">
          <pose>-4 0 0.051 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.9</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.55 0.85 1</ambient>
            <diffuse>0.15 0.7 1 1</diffuse>
          </material>
        </visual>
        <visual name="pad_2">
          <pose>0 0 0.051 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.9</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.55 0.85 1</ambient>
            <diffuse>0.15 0.7 1 1</diffuse>
          </material>
        </visual>
        <visual name="pad_3">
          <pose>4 0 0.051 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.9</radius>
              <length>0.002</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.55 0.85 1</ambient>
            <diffuse>0.15 0.7 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="uav_1_lidar">
      <static>true</static>
      <pose>-34 -23 0.73 0 0 0</pose>
      <link name="lidar_link">
        <sensor name="scan" type="gpu_lidar">
          <gz_frame_id>uav_1/lidar_link</gz_frame_id>
          <topic>/mupt/uav_1/scan</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <ray>
            <scan>
              <horizontal>
                <samples>120</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159265</min_angle>
                <max_angle>3.14159265</max_angle>
              </horizontal>
              <vertical>
                <samples>3</samples>
                <resolution>1</resolution>
                <min_angle>-0.20943951</min_angle>
                <max_angle>0.20943951</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.6</min>
              <max>20</max>
              <resolution>0.02</resolution>
            </range>
            <noise>
              <type>gaussian</type>
              <mean>0</mean>
              <stddev>0.01</stddev>
            </noise>
          </ray>
        </sensor>
        <sensor name="down_scan" type="gpu_lidar">
          <pose>0 0 -1.0 0 1.57079633 0</pose>
          <gz_frame_id>uav_1/down_lidar_link</gz_frame_id>
          <topic>/mupt/uav_1/down_scan</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <ray>
            <scan>
              <horizontal>
                <samples>5</samples>
                <resolution>1</resolution>
                <min_angle>-0.261799</min_angle>
                <max_angle>0.261799</max_angle>
              </horizontal>
              <vertical>
                <samples>5</samples>
                <resolution>1</resolution>
                <min_angle>-0.261799</min_angle>
                <max_angle>0.261799</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.3</min>
              <max>15</max>
              <resolution>0.02</resolution>
            </range>
          </ray>
        </sensor>
      </link>
    </model>
