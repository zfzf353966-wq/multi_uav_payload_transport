<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <world name="logistics_city">
    <!-- Explicit PX4 world systems are required because the moving obstacle also
         loads a model system plugin, which disables Gazebo's default plugin set. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system" name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics name="fast_urban_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <grid>false</grid>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.64 0.78 0.92 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 100 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>0.9</intensity>
      <direction>-0.35 0.25 -0.9</direction>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation><range>1000</range><constant>1</constant><linear>0</linear><quadratic>0</quadratic></attenuation>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971</latitude_deg>
      <longitude_deg>8.546164</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- Ground and cross-shaped road network. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>80 60</size></plane></geometry>
          <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface>
        </collision>
        <visual name="grass">
          <geometry><plane><normal>0 0 1</normal><size>80 60</size></plane></geometry>
          <material><ambient>0.18 0.34 0.16 1</ambient><diffuse>0.24 0.46 0.21 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="roads">
      <static>true</static>
      <link name="link">
        <visual name="east_west_road">
          <pose>0 0 0.012 0 0 0</pose>
          <geometry><box><size>80 7 0.02</size></box></geometry>
          <material><ambient>0.09 0.10 0.11 1</ambient><diffuse>0.16 0.17 0.18 1</diffuse></material>
        </visual>
        <visual name="north_south_road">
          <pose>10 0 0.014 0 0 0</pose>
          <geometry><box><size>7 60 0.02</size></box></geometry>
          <material><ambient>0.09 0.10 0.11 1</ambient><diffuse>0.16 0.17 0.18 1</diffuse></material>
        </visual>
        <visual name="depot_access_road">
          <pose>-25 -22 0.016 0 0 0</pose>
          <geometry><box><size>30 6 0.02</size></box></geometry>
          <material><ambient>0.09 0.10 0.11 1</ambient><diffuse>0.16 0.17 0.18 1</diffuse></material>
        </visual>
        <visual name="lane_line_x">
          <pose>0 0 0.03 0 0 0</pose>
          <geometry><box><size>80 0.12 0.02</size></box></geometry>
          <material><ambient>0.9 0.8 0.15 1</ambient><diffuse>0.95 0.85 0.2 1</diffuse></material>
        </visual>
        <visual name="lane_line_y">
          <pose>10 0 0.032 0 0 0</pose>
          <geometry><box><size>0.12 60 0.02</size></box></geometry>
          <material><ambient>0.9 0.8 0.15 1</ambient><diffuse>0.95 0.85 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- UAV logistics depot and three numbered launch pads. -->
    <model name="uav_depot">
      <static>true</static>
      <pose>-30 -23 0.055 0 0 0</pose>
      <link name="link">
        <collision name="apron_collision"><geometry><box><size>10 6 0.1</size></box></geometry></collision>
        <visual name="apron_visual">
          <geometry><box><size>10 6 0.1</size></box></geometry>
          <material><ambient>0.35 0.37 0.39 1</ambient><diffuse>0.55 0.57 0.59 1</diffuse></material>
        </visual>
        <visual name="pad_1">
          <pose>-4 0 0.051 0 0 0</pose><geometry><cylinder><radius>0.9</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.1 0.55 0.85 1</ambient><diffuse>0.15 0.7 1 1</diffuse></material>
        </visual>
        <visual name="pad_2">
          <pose>0 0 0.051 0 0 0</pose><geometry><cylinder><radius>0.9</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.1 0.55 0.85 1</ambient><diffuse>0.15 0.7 1 1</diffuse></material>
        </visual>
        <visual name="pad_3">
          <pose>4 0 0.051 0 0 0</pose><geometry><cylinder><radius>0.9</radius><length>0.002</length></cylinder></geometry>
          <material><ambient>0.1 0.55 0.85 1</ambient><diffuse>0.15 0.7 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Six buildings. Collision dimensions match config/logistics_city.yaml. -->
    <model name="building_1">
      <static>true</static><pose>-21 -11 6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 10 12</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>12 10 12</size></box></geometry><material><ambient>0.52 0.30 0.22 1</ambient><diffuse>0.72 0.43 0.32 1</diffuse></material></visual>
        <visual name="roof"><pose>0 0 6.08 0 0 0</pose><geometry><box><size>12.4 10.4 0.16</size></box></geometry><material><ambient>0.24 0.25 0.27 1</ambient><diffuse>0.36 0.38 0.40 1</diffuse></material></visual>
      </link>
    </model>
    <model name="building_2">
      <static>true</static><pose>0 -12 9 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 12 18</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>10 12 18</size></box></geometry><material><ambient>0.28 0.40 0.52 1</ambient><diffuse>0.38 0.55 0.70 1</diffuse></material></visual>
        <visual name="roof"><pose>0 0 9.08 0 0 0</pose><geometry><box><size>10.4 12.4 0.16</size></box></geometry><material><ambient>0.22 0.23 0.25 1</ambient><diffuse>0.34 0.35 0.37 1</diffuse></material></visual>
      </link>
    </model>
    <model name="building_3">
      <static>true</static><pose>21 -11 4.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14 10 9</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>14 10 9</size></box></geometry><material><ambient>0.47 0.45 0.32 1</ambient><diffuse>0.69 0.66 0.46 1</diffuse></material></visual>
        <visual name="roof"><pose>0 0 4.58 0 0 0</pose><geometry><box><size>14.4 10.4 0.16</size></box></geometry><material><ambient>0.24 0.25 0.27 1</ambient><diffuse>0.36 0.38 0.40 1</diffuse></material></visual>
      </link>
    </model>
    <model name="building_4">
      <static>true</static><pose>-21 12 10 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 14 20</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>10 14 20</size></box></geometry><material><ambient>0.45 0.31 0.46 1</ambient><diffuse>0.64 0.44 0.65 1</diffuse></material></visual>
        <visual name="roof"><pose>0 0 10.08 0 0 0</pose><geometry><box><size>10.4 14.4 0.16</size></box></geometry><material><ambient>0.22 0.23 0.25 1</ambient><diffuse>0.34 0.35 0.37 1</diffuse></material></visual>
      </link>
    </model>
    <model name="building_5">
      <static>true</static><pose>0 13 7 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14 10 14</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>14 10 14</size></box></geometry><material><ambient>0.25 0.46 0.43 1</ambient><diffuse>0.34 0.65 0.60 1</diffuse></material></visual>
        <visual name="roof"><pose>0 0 7.08 0 0 0</pose><geometry><box><size>14.4 10.4 0.16</size></box></geometry><material><ambient>0.24 0.25 0.27 1</ambient><diffuse>0.36 0.38 0.40 1</diffuse></material></visual>
      </link>
    </model>
    <model name="building_6">
      <static>true</static><pose>21 13 11.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12 14 23</size></box></geometry></collision>
        <visual name="body"><geometry><box><size>12 14 23</size></box></geometry><material><ambient>0.45 0.36 0.25 1</ambient><diffuse>0.66 0.53 0.36 1</diffuse></material></visual>
        <visual name="roof"><pose>0 0 11.58 0 0 0</pose><geometry><box><size>12.4 14.4 0.16</size></box></geometry><material><ambient>0.22 0.23 0.25 1</ambient><diffuse>0.34 0.35 0.37 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Yellow pickup pads and blue delivery pads. -->
    <model name="pickup_pads">
      <static>true</static>
      <link name="link">
        <visual name="pickup_1"><pose>-21 -11 12.18 0 0 0</pose><geometry><box><size>3 3 0.12</size></box></geometry><material><ambient>0.85 0.58 0.04 1</ambient><diffuse>1 0.72 0.06 1</diffuse></material></visual>
        <visual name="pickup_2"><pose>0 -12 18.18 0 0 0</pose><geometry><box><size>3 3 0.12</size></box></geometry><material><ambient>0.85 0.58 0.04 1</ambient><diffuse>1 0.72 0.06 1</diffuse></material></visual>
        <visual name="pickup_3"><pose>0 13 14.18 0 0 0</pose><geometry><box><size>3 3 0.12</size></box></geometry><material><ambient>0.85 0.58 0.04 1</ambient><diffuse>1 0.72 0.06 1</diffuse></material></visual>
        <visual name="delivery_1"><pose>21 -11 9.18 0 0 0</pose><geometry><cylinder><radius>1.5</radius><length>0.12</length></cylinder></geometry><material><ambient>0.03 0.45 0.82 1</ambient><diffuse>0.05 0.62 1 1</diffuse></material></visual>
        <visual name="delivery_2"><pose>-21 12 20.18 0 0 0</pose><geometry><cylinder><radius>1.5</radius><length>0.12</length></cylinder></geometry><material><ambient>0.03 0.45 0.82 1</ambient><diffuse>0.05 0.62 1 1</diffuse></material></visual>
        <visual name="delivery_3"><pose>21 13 23.18 0 0 0</pose><geometry><cylinder><radius>1.5</radius><length>0.12</length></cylinder></geometry><material><ambient>0.03 0.45 0.82 1</ambient><diffuse>0.05 0.62 1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Six task packages. The mission node resets their poses from plan.json at startup. -->
    <include><uri>model://delivery_package</uri><name>package_1</name><pose>-0.45 12.55 14.48 0 0 0</pose></include>
    <include><uri>model://delivery_package</uri><name>package_2</name><pose>-21.45 -11 12.48 0 0 0</pose></include>
    <include><uri>model://delivery_package</uri><name>package_3</name><pose>0 -12 18.48 0 0 0</pose></include>
    <include><uri>model://delivery_package</uri><name>package_4</name><pose>-20.55 -11 12.48 0 0 0</pose></include>
    <include><uri>model://delivery_package</uri><name>package_5</name><pose>0.45 12.55 14.48 0 0 0</pose></include>
    <include><uri>model://delivery_package</uri><name>package_6</name><pose>0 13.45 14.48 0 0 0</pose></include>

    <!-- A lightweight moving sphere stands in for a bird during avoidance tests. -->
    <model name="moving_obstacle_1">
      <!-- Orbit above the open road junction; the path never intersects a building. -->
      <pose>10 0 8 0 0 0</pose>
      <link name="anchor_link">
        <inertial><mass>1</mass><inertia><ixx>1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1</iyy><iyz>0</iyz><izz>1</izz></inertia></inertial>
      </link>
      <link name="sphere_link">
        <pose>4 0 0 0 0 0</pose>
        <gravity>false</gravity>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.04</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.04</iyy><iyz>0</iyz><izz>0.04</izz></inertia>
        </inertial>
        <collision name="collision"><geometry><sphere><radius>0.45</radius></sphere></geometry></collision>
        <visual name="visual">
          <geometry><sphere><radius>0.45</radius></sphere></geometry>
          <material><ambient>0.75 0.03 0.03 1</ambient><diffuse>1 0.06 0.06 1</diffuse></material>
        </visual>
      </link>
      <joint name="anchor_to_world" type="fixed">
        <parent>world</parent><child>anchor_link</child>
      </joint>
      <joint name="orbit_joint" type="revolute">
        <pose relative_to="__model__">0 0 0 0 0 0</pose>
        <parent>anchor_link</parent><child>sphere_link</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>
      <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
        <joint_name>orbit_joint</joint_name>
        <initial_velocity>0.5</initial_velocity>
      </plugin>
    </model>

    <!-- Low-poly trees are physical obstacles for the lidar and planner. -->
    <include><uri>model://simple_tree</uri><name>tree_1</name><pose>-37 -10 0 0 0 0</pose></include>
    <include><uri>model://simple_tree</uri><name>tree_2</name><pose>-36 10 0 0 0 0</pose></include>
    <include><uri>model://simple_tree</uri><name>tree_3</name><pose>-10 -25 0 0 0 0</pose></include>
    <include><uri>model://simple_tree</uri><name>tree_4</name><pose>11 -25 0 0 0 0</pose></include>
    <include><uri>model://simple_tree</uri><name>tree_5</name><pose>36 -5 0 0 0 0</pose></include>
    <include><uri>model://simple_tree</uri><name>tree_6</name><pose>35 5 0 0 0 0</pose></include>
  </world>
</sdf>
