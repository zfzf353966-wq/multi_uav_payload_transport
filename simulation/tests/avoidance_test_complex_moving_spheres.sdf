<?xml version="1.0"?>
<sdf version="1.9">
  <model name="complex_moving_obstacles">
    <link name="anchor_link">
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1</iyy><iyz>0</iyz><izz>1</izz></inertia>
      </inertial>
    </link>

    <link name="red_sphere">
      <pose>-3.8 0 0 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.03</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.03</iyy><iyz>0</iyz><izz>0.03</izz></inertia>
      </inertial>
      <collision name="collision"><geometry><sphere><radius>0.75</radius></sphere></geometry></collision>
      <visual name="visual">
        <geometry><sphere><radius>0.75</radius></sphere></geometry>
        <material><ambient>0.8 0.02 0.02 1</ambient><diffuse>1 0.03 0.03 1</diffuse></material>
      </visual>
    </link>
    <link name="orange_sphere">
      <pose>0 2.5 0 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.03</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.03</iyy><iyz>0</iyz><izz>0.03</izz></inertia>
      </inertial>
      <collision name="collision"><geometry><sphere><radius>0.7</radius></sphere></geometry></collision>
      <visual name="visual">
        <geometry><sphere><radius>0.7</radius></sphere></geometry>
        <material><ambient>0.9 0.25 0.01 1</ambient><diffuse>1 0.4 0.02 1</diffuse></material>
      </visual>
    </link>
    <link name="purple_sphere">
      <pose>4 0 0 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.03</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.03</iyy><iyz>0</iyz><izz>0.03</izz></inertia>
      </inertial>
      <collision name="collision"><geometry><sphere><radius>0.65</radius></sphere></geometry></collision>
      <visual name="visual">
        <geometry><sphere><radius>0.65</radius></sphere></geometry>
        <material><ambient>0.35 0.02 0.75 1</ambient><diffuse>0.55 0.05 1 1</diffuse></material>
      </visual>
    </link>

    <joint name="anchor_to_world" type="fixed"><parent>world</parent><child>anchor_link</child></joint>
    <joint name="red_orbit" type="revolute">
      <pose relative_to="__model__">-6 0 0 0 0 0</pose>
      <parent>anchor_link</parent><child>red_sphere</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
    <joint name="orange_orbit" type="revolute">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <parent>anchor_link</parent><child>orange_sphere</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
    <joint name="purple_orbit" type="revolute">
      <pose relative_to="__model__">6 0 0 0 0 0</pose>
      <parent>anchor_link</parent><child>purple_sphere</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>red_orbit</joint_name><initial_velocity>0.42</initial_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>orange_orbit</joint_name><initial_velocity>-0.34</initial_velocity>
    </plugin>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>purple_orbit</joint_name><initial_velocity>0.48</initial_velocity>
    </plugin>
  </model>
</sdf>
