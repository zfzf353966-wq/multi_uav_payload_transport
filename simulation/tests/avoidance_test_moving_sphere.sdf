<?xml version="1.0"?>
<sdf version="1.9">
  <model name="closed_loop_moving_test_obstacle">
    <link name="anchor_link">
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>1</ixx><ixy>0</ixy><ixz>0</ixz><iyy>1</iyy><iyz>0</iyz><izz>1</izz></inertia>
      </inertial>
    </link>
    <link name="sphere_link">
      <!-- A 2.5 m orbit repeatedly crosses UAV 1's nominal centreline. -->
      <pose>2.5 0 0 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.03</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.03</iyy><iyz>0</iyz><izz>0.03</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.75</radius></sphere></geometry>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.75</radius></sphere></geometry>
        <material>
          <ambient>0.8 0.02 0.02 1</ambient>
          <diffuse>1 0.03 0.03 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="anchor_to_world" type="fixed">
      <parent>world</parent><child>anchor_link</child>
    </joint>
    <joint name="orbit_joint" type="revolute">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <parent>anchor_link</parent><child>sphere_link</child>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>orbit_joint</joint_name>
      <initial_velocity>0.35</initial_velocity>
    </plugin>
  </model>
</sdf>
