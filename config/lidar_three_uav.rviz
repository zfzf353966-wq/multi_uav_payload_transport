Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /UAV 1 Three-Layer Cloud1
        - /UAV 2 Three-Layer Cloud1
        - /UAV 3 Three-Layer Cloud1
    Tree Height: 650
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 2
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 125
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Ground Grid
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 1
      Name: UAV Sensor Frames
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Tree: {}
      Update Interval: 0
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 70; 70
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: UAV 1 Three-Layer Cloud
      Position Transformer: XYZ
      Queue Size: 50
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.08
      Style: Points
      Topic: /mupt/uav_1/scan/points
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 70; 255; 100
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: UAV 2 Three-Layer Cloud
      Position Transformer: XYZ
      Queue Size: 50
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.08
      Style: Points
      Topic: /mupt/uav_2/scan/points
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 70; 130; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: UAV 3 Three-Layer Cloud
      Position Transformer: XYZ
      Queue Size: 50
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.08
      Style: Points
      Topic: /mupt/uav_3/scan/points
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 35; 35; 40
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 85
      Focal Point: {X: 0, Y: 0, Z: 5}
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.85
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1400
